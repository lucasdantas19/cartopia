# Environment files and local configuration
.env
.env.*
!.env.example
!.env.*.example

# JavaScript dependencies and build output
**/node_modules/
**/dist/
**/dist-ssr/
**/.expo/
*.local
*.log
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# PHP dependencies and generated framework files
/backend/vendor/
/backend/bootstrap/cache/*
!/backend/bootstrap/cache/.gitignore
/backend/storage/framework/views/*
!/backend/storage/framework/views/.gitignore
/backend/storage/logs/*
!/backend/storage/logs/.gitignore
/backend/storage/app/private/*
!/backend/storage/app/private/.gitignore
/backend/storage/app/public/*
!/backend/storage/app/public/.gitignore

# Local databases and test artifacts
*.sqlite
*.sqlite-*
*.phpunit.result.cache
/backend/.phpunit.cache/

# Expo-generated TypeScript environment declaration
/mobile/expo-env.d.ts

# Operating system and editor files
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json
