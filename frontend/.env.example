VITE_API_URL=http://localhost:8000/api
VITE_REVERB_ENABLED=true
VITE_REVERB_APP_KEY=cartopia-local-key
VITE_REVERB_HOST=localhost
VITE_REVERB_PORT=8080
VITE_REVERB_SCHEME=http
# Opcional; por padrão usa VITE_API_URL/broadcasting/auth.
# VITE_BROADCAST_AUTH_URL=http://localhost:8000/api/broadcasting/auth

# Produção: use somente URLs públicas HTTPS/WSS, por exemplo:
# VITE_API_URL=https://api.example.com/api
# VITE_REVERB_HOST=ws.example.com
# VITE_REVERB_PORT=443
# VITE_REVERB_SCHEME=https
# VITE_BROADCAST_AUTH_URL=https://api.example.com/api/broadcasting/auth
# VITE_REVERB_APP_KEY é público; nunca coloque aqui REVERB_APP_SECRET.
# VITE_PRIVACY_CONTACT_EMAIL=
