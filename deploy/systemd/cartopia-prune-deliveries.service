[Unit]
Description=Cartopia delivery retention cleanup
After=postgresql.service

[Service]
Type=oneshot
User=cartopia
Group=www-data
WorkingDirectory=/srv/cartopia/current/backend
EnvironmentFile=/srv/cartopia/shared/.env
ExecStart=/usr/bin/php8.4 artisan cartopia:prune-deliveries
NoNewPrivileges=true
PrivateTmp=true
