APP_ENV=testing
APP_DEBUG=true
APP_KEY=

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=cartopia_test
DB_USERNAME=cartopia
DB_PASSWORD=

# Keep test counters in memory; do not use the development cache database.
CACHE_STORE=array

DELIVERY_RETENTION_DAYS=90
DELIVERY_RETENTION_BATCH_SIZE=100

# Laravel stores and casts delivery instants in UTC.
